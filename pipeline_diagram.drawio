          <mxGeometry x="80" y="360" width="740" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="STEP 2 — Backlog gate&#xa;Notion query: Status = drafted" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#B8663F;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="440" width="340" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a2z1" value="&lt; 8 drafted&#xa;NORMAL&#xa;top 3 to 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3EA;strokeColor=#3E7B3E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2z2" value="8 to 10 drafted&#xa;CAP at 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B58D00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="580" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2z3" value="11+ drafted&#xa;HARD PAUSE&#xa;skip steps 3 to 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE0E0;strokeColor=#B84A4A;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="580" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="STEP 3 — Reconciliation&#xa;Notion ↔ applied-log.csv (Notion wins; runs even on pause)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="740" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="STEP 4 — Search • filter • score • tailor&#xa;&#xa;• Sources: LinkedIn, Xing, StepStone, Indeed MCP, company career pages (Tavily)&#xa;• Language track = posting body language (20 Jul 2026 rule)&#xa;• Author role_configs_YYYYMMDD.py + run_YYYYMMDD.py&#xa;• Invoke build_html.py&#xa;• Render 8 deliverables per role: CV (md/html/pdf/docx) + CL (md/html/pdf/docx)&#xa;• Overflow ladder trims until PDF ≤ 2 pages (19 Aug 2026 rule)&#xa;• Validate PDF against banned strings; HALT role on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontSize=11;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="740" height="220" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="STEP 5 — Dual write&#xa;• Append to applied-log.csv (Status=drafted)&#xa;• Create Notion row (Status=drafted, Date Drafted, Draft Path, Apply Link, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1040" width="740" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="STEP 6 — Digest + Gmail&#xa;• Write Job_Digest_YYYY-MM-DD.md (top cut, watchlist, dropped, transparency block)&#xa;• Create Gmail DRAFT to rahulrawat2r@gmail.com&#xa;• NEVER send (Gmail or LinkedIn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1170" width="740" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a7" value="STEP 7 — Git commit + push&#xa;git add -A && git commit && git push origin main (retry once, never force push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="1320" width="740" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a8" value="STEP 8 — Verify&#xa;• 8 files per drafted folder&#xa;• CSV drafted count ↔ Notion drafted count match&#xa;• git log -1 origin/main (commit hash in final summary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
