        </mxCell>

        <mxCell id="a0" value="STEP 0 — Environment preflight&#xa;git clone JobSearch&#xa;pip install weasyprint python-docx pypdf&#xa;HALT on toolchain fail (never fall back to md-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="740" height="80" as="geometry" />
        </mxCell>

